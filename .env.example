# OSMAN DJ V5 — gizli ayarlar. Bu dosyayı ".env" adıyla kopyala ve doldur. Kimseyle paylaşma.

# YouTube (README: "YouTube bağlama")
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# 7/24 canlı yayın anahtarı (YouTube Studio → Canlı yayına geç → Yayın anahtarı)
YT_STREAM_KEY=

# İsteğe bağlı: Claude başlık/açıklama yazsın (yoksa şablon kullanılır)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# GitHub repolarını VPS'e tanımlamak için (README): fine-grained token, Administration: Read and write
GH_RUNNER_PAT=
