#!/usr/bin/env bash
# OSMAN DJ yönetim komutu
DIR=/opt/osmandj
cd "$DIR" || { echo "OSMAN DJ kurulu değil ($DIR yok)"; exit 1; }
case "${1:-durum}" in
  durum)
    echo "🌟 OSMAN DJ durumu"
    docker compose ps --format '   {{.Name}}: {{.Status}}' 2>/dev/null
    [ -f out/state.json ] && echo "   Üretim: $(python3 -c "import json;s=json.load(open('out/state.json'));print(f\"toplam {s.get('total',0)} set · bugün {s.get('count',0)} · son sonuç: {s.get('lastResult','-')}\")" 2>/dev/null)"
    ls -d out/_uretim_* >/dev/null 2>&1 && echo "   ⏳ Şu an üretimde: $(tail -1 out/_uretim_*/log.txt 2>/dev/null | head -1)"
    if [ -f out/arsiv/katalog.json ]; then
      echo "   📼 Arşiv:"; python3 -c "
import json;c=json.load(open('out/arsiv/katalog.json'))
for s in c['sets'][-10:]: print(f\"      #{s['no']:04d} {s['name']} · {s['program']} · kalite {s.get('score')} · {'YouTube ✓' if s.get('youtube') else 'YouTube bekliyor'}\")" 2>/dev/null
    else echo "   📼 Arşiv henüz boş (ilk set üretiliyor)"; fi
    echo "   💾 Boş disk: $(df -h --output=avail $DIR | tail -1 | tr -d ' ')"
    grep -q '^YT_REFRESH_TOKEN=.\+' .env && echo "   📺 YouTube: bağlı" || echo "   📺 YouTube: bağlı değil (README → YouTube bağlama)"
    [ -f runners.compose.yml ] && echo "   🤖 GitHub çalıştırıcıları: $(docker compose -f runners.compose.yml -p osmandj-runners ps -q 2>/dev/null | wc -l) aktif"
    grep -q '^YT_STREAM_KEY=.\+' .env && echo "   📻 Radyo: anahtar var" || echo "   📻 Radyo: yayın anahtarı yok" ;;
  log)        docker compose logs -f --tail 80 studio ;;
  radyo-log)  docker compose logs -f --tail 50 radyo ;;
  guncelle)   git pull -q && install -m 755 scripts/osmandj /usr/local/bin/osmandj && docker compose build -q && docker compose up -d && echo "✅ güncellendi" ;;
  yukle)      docker compose run --rm studio node src/upload-pending.js "${@:2}" ;;
  bagla)      docker compose run --rm -p 127.0.0.1:8085:8085 -e AUTH_HOST=0.0.0.0 -v "$PWD/src/auth.js:/app/src/auth.js" studio node src/auth.js && docker compose up -d --force-recreate >/dev/null 2>&1 && echo "📺 YouTube bağlandı. Biriken setler için:  osmandj yukle" ;;
  youtube)
    read -p "Google OAuth Client ID: " A; read -p "Google OAuth Client Secret: " B
    A=$(echo "$A"|tr -d '[:space:]'); B=$(echo "$B"|tr -d '[:space:]')
    sed -i '/^YT_CLIENT_ID=/d;/^YT_CLIENT_SECRET=/d' .env; printf 'YT_CLIENT_ID=%s\nYT_CLIENT_SECRET=%s\n' "$A" "$B" >> .env
    echo "✅ kaydedildi. Şimdi çıkan linki KENDİ bilgisayarındaki tarayıcıda aç ve kanal hesabınla izin ver."
    echo "   (Bu SSH oturumunu  ssh -L 8085:127.0.0.1:8085 root@IP  ile açmış olman gerekir)"
    docker compose run --rm -p 127.0.0.1:8085:8085 -e AUTH_HOST=0.0.0.0 -v "$PWD/src/auth.js:/app/src/auth.js" studio node src/auth.js && docker compose up -d --force-recreate >/dev/null 2>&1 && echo "📺 YouTube bağlandı. Biriken setler için:  osmandj yukle" ;;
  yayin)
    read -s -p "YouTube yayın anahtarı: " K; echo; K=$(echo "$K"|tr -d '[:space:]')
    sed -i '/^YT_STREAM_KEY=/d' .env; echo "YT_STREAM_KEY=$K" >> .env
    docker compose up -d --force-recreate radyo >/dev/null 2>&1 && echo "📻 7/24 radyo başlıyor:  osmandj radyo-log" ;;
  arsiv)      ls -1 out/arsiv | grep -v -E 'katalog|index' ;;
  rapor)      docker compose exec -T studio node src/notify.js ;;
  telegram)   read -p "Telegram bot token: " A; read -p "Telegram chat id: " B; sed -i '/^TELEGRAM_BOT_TOKEN=/d;/^TELEGRAM_CHAT_ID=/d' .env; printf 'TELEGRAM_BOT_TOKEN=%s\nTELEGRAM_CHAT_ID=%s\n' "$(echo $A|tr -d '[:space:]')" "$(echo $B|tr -d '[:space:]')" >> .env; docker compose up -d --force-recreate >/dev/null 2>&1; sleep 3; docker compose exec -T studio node src/notify.js ;;
  token)      read -s -p "GitHub token: " T; echo; T=$(echo "$T"|tr -d '[:space:]'); sed -i '/^GH_RUNNER_PAT=/d' .env; echo "GH_RUNNER_PAT=$T" >> .env; echo "✅ token kaydedildi ($(echo -n $T|wc -c) karakter)"; bash scripts/runner-kur.sh ;;
  runner-kur) bash scripts/runner-kur.sh ;;
  runner-gecis) python3 scripts/runner-gecis.py ;;
  runner-geri) python3 scripts/runner-gecis.py geri ;;
  runner-durum) docker compose -f runners.compose.yml -p osmandj-runners ps --format '   {{.Name}}: {{.Status}}' ;;
  runner-log) docker compose -f runners.compose.yml -p osmandj-runners logs -f --tail 30 ;;
  dur)        docker compose stop && echo "⏸ durdu" ;;
  basla)      docker compose up -d && echo "▶ çalışıyor" ;;
  *) echo "kullanım: osmandj [durum|rapor|telegram|youtube|yayin|token|log|radyo-log|guncelle|yukle|bagla|arsiv|runner-kur|runner-gecis|runner-geri|runner-durum|runner-log|dur|basla]" ;;
esac
